{
	"extends": "../../tsconfig.base.json",
	"include": [".next/types/**/*.ts", "src", ".next-quality/types/**/*.ts"],
	"compilerOptions": {
		"allowJs": true,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"allowImportingTsExtensions": true,
		"lib": ["dom", "dom.iterable", "ES2022"]
	},
	"exclude": ["node_modules"]
}
