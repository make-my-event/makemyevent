# Copy to .env.local / .env.staging / .env.production. Never commit a filled copy.
# One file per environment; APP_ENV selects which one tooling loads.
# local | staging | production
APP_ENV=local

# --- Supabase (Auth) ---
# Dashboard → Project Settings → API Keys. Use the new keys (sb_publishable_ / sb_secret_),
# not the legacy anon / service_role keys.
# API: verifies sign-in tokens against this project
SUPABASE_URL=
# API only: auth admin (invites, account deletion). Never in web or mobile.
SUPABASE_SECRET_KEY=
# pooled (transaction mode, port 6543) — Prisma client at runtime
DATABASE_URL=
# direct (port 5432) — Prisma migrate only
DIRECT_URL=
# encrypts database backups; store a copy in a password manager
BACKUP_PASSPHRASE=

# --- Public (prefixed so Next.js / Expo expose them) ---
NEXT_PUBLIC_SUPABASE_URL=
# public, safe in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# https://makemyevent.org | staging: the host's free address | http://localhost:3000
NEXT_PUBLIC_APP_URL=
EXPO_PUBLIC_SUPABASE_URL=
# public, safe in the app
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=

# --- Auth: Supabase Auth + Google provider ---
# Web: Google client ID/secret are set in the Supabase dashboard (Auth → Providers → Google),
#      NOT here. One Google OAuth client per environment; its redirect URI is
#      https://<project-ref>.supabase.co/auth/v1/callback
#      Add NEXT_PUBLIC_APP_URL/auth/callback to Supabase Auth → URL configuration → Redirect URLs.
# Mobile: native Google Sign-In needs its own client IDs (public, safe to embed).
# "Web application" client; used to mint the ID token
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# "iOS" client; bundle ID must match app.json
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# "Android" client; package name + SHA-1 from EAS credentials
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# app scheme for the OAuth return, e.g. makemyevent://auth
EXPO_PUBLIC_AUTH_REDIRECT_SCHEME=

# --- API ---
# API: comma-separated web origins allowed to call it
CORS_ORIGINS=

# --- Redis (Upstash) ---
REDIS_URL=

# --- Stripe Connect (use test keys everywhere except production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email / storage / monitoring ---
RESEND_API_KEY=
EMAIL_FROM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=

# --- Ticket signing (per-env, 32+ random bytes, base64) ---
TICKET_SIGNING_KEY=
