# Copy to .env.local / .env.staging / .env.production. Never commit a filled copy.
# One file per environment; APP_ENV selects which one tooling loads.
APP_ENV=local            # local | staging | production

# --- Supabase (Postgres + Auth + Storage) ---
# local:      your local Postgres (DATABASE_URL = DIRECT_URL)
# staging/prod: Supabase dashboard → Project Settings → API / Database
SUPABASE_URL=
SUPABASE_ANON_KEY=                 # safe for clients
SUPABASE_SERVICE_ROLE_KEY=         # server only. Never shipped to web or mobile.
DATABASE_URL=                      # pooled (transaction mode, port 6543) — Prisma client at runtime
DIRECT_URL=                        # direct (port 5432) — Prisma migrate only

# --- Public (prefixed so Next.js / Expo expose them) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=               # https://<domain> | https://staging.<domain> | http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=

# --- Redis (Upstash) ---
REDIS_URL=

# --- Stripe Connect (use test keys everywhere except production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email / storage / monitoring ---
RESEND_API_KEY=
EMAIL_FROM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SENTRY_DSN=

# --- Ticket signing (per-env, 32+ random bytes, base64) ---
TICKET_SIGNING_KEY=
